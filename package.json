{
  "name": "znaki",
  "version": "0.2.0",
  "description": "Typesafe SVG icons for Vite — collects the icons you actually use at build time, ships them as a sprite, and generates a union type of every icon name.",
  "keywords": [
    "icons",
    "iconset",
    "react",
    "solid",
    "solid-js",
    "sprite",
    "svg",
    "svg-sprite",
    "tabler",
    "typesafe",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/znaki.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "solid": "./dist/solid/index.jsx",
      "default": "./dist/solid/index.jsx"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./client": "./dist/client.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "fmt": "oxfmt",
    "lint": "oxlint --type-aware --type-check",
    "test": "vitest",
    "test:matrix": "pnpm test:vite7 && pnpm test:vite8",
    "test:run": "vitest run",
    "test:vite7": "cross-env VITE_DEPENDENCY=vite7 vitest run --project unit --project vite",
    "test:vite8": "cross-env VITE_DEPENDENCY=vite8 vitest run --project unit --project vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.react.json",
    "version": "changeset version"
  },
  "dependencies": {
    "oxc-parser": "^0.148.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@solidjs/vite-plugin": "^3.0.0-next.38",
    "@solidjs/web": "2.0.0-rc.4",
    "@tabler/icons": "^3.46.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.13.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-js": "2.0.0-rc.4",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite7": "npm:vite@^7",
    "vite8": "npm:vite@^8",
    "vitest": "5.0.0-rc.4"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.4",
    "@tabler/icons": ">=3",
    "react": ">=19",
    "solid-js": ">=2.0.0-rc.4",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "@tabler/icons": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.0.0"
}
