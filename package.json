{
  "name": "znaki",
  "version": "0.4.0",
  "description": "Compiler-first, typesafe SVG icons for Vite and custom frameworks.",
  "keywords": [
    "icons",
    "iconset",
    "react",
    "solid",
    "solid-js",
    "sprite",
    "svg",
    "svg-sprite",
    "tabler",
    "typesafe",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/znaki.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./client": "./dist/client.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "fmt": "oxfmt",
    "lint": "oxlint --type-aware --type-check",
    "test": "vitest",
    "test:matrix": "pnpm test:vite7 && pnpm test:vite8 && pnpm test:run --project react --project solid --project runtime",
    "test:run": "vitest run",
    "test:vite7": "cross-env VITE_DEPENDENCY=vite7 vitest run --project unit --project vite",
    "test:vite8": "cross-env VITE_DEPENDENCY=vite8 vitest run --project unit --project vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/react/tsconfig.json",
    "version": "changeset version"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "magic-string": "^1.4.2",
    "oxc-parser": "^0.152.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@solidjs/vite-plugin": "^3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.9",
    "@tabler/icons": "^3.48.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "filesystem-routing": "^0.4.0",
    "happy-dom": "^20.14.5",
    "lucide-static": "^1.51.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "2.0.0-rc.9",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite7": "npm:vite@^8.3.2",
    "vite8": "npm:vite@^8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@tabler/icons": ">=3",
    "lucide-static": ">=1",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "@tabler/icons": {
      "optional": true
    },
    "lucide-static": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.0.0"
}
